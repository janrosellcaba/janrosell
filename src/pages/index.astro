---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import { getHome, getExperience } from '../lib/keystatic';

const home = await getHome();
const experience = await getExperience();
const currentJobs = experience.filter((item) => item.current);

const currentYear = new Date().getFullYear();

const iconStroke =
	'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"';

const projects = [
	{
		slug: 'emh',
		featured: true,
		name: 'Express My Health',
		url: 'https://expressmyhealth.com',
		tagline: 'Assistive communication for care',
		description:
			'Secure platform for people with communication barriers — patient check-ins, risk alerts, and tutor follow-up.',
		icon: `<svg ${iconStroke}><path d="M2 12h3.2l1.6-5 2.6 10 1.8-5H22" /></svg>`,
	},
	{
		slug: 'finance',
		featured: false,
		name: 'Finance',
		url: 'https://fin.janrosell.com',
		tagline: 'Personal finance, at a glance',
		description: 'Track income, expenses and trends with a calm dashboard for everyday money decisions.',
		icon: `<svg ${iconStroke}><path d="M3 16.5 8.2 11l3.4 3.2L21 5" /><path d="M15.5 5H21v5.5" /></svg>`,
	},
	{
		slug: 'sport',
		featured: false,
		name: 'Sport',
		url: 'https://sport.janrosell.com',
		tagline: 'Training, logged',
		description: 'Workouts, recovery and weekly load in a dark, lime-accented tracker.',
		icon: `<svg ${iconStroke}><path d="M13 2 4.5 14h7.1L9.2 22 19.5 8.8h-7.2L13 2Z" /></svg>`,
	},
	{
		slug: 'canina',
		featured: false,
		name: 'Solución Canina',
		url: 'https://www.solucioncanina.es',
		tagline: 'Behaviour, education, wellbeing',
		description: 'Canine behaviour and education — a living knowledge base for dog professionals and owners.',
		icon: `<svg ${iconStroke}><circle cx="9.35" cy="6.9" r="1.3" /><circle cx="14.65" cy="6.9" r="1.3" /><circle cx="5.85" cy="10.3" r="1.15" /><circle cx="18.15" cy="10.3" r="1.15" /><ellipse cx="12" cy="16.5" rx="3.5" ry="2.75" /></svg>`,
	},
];

const featuredProject = projects.find((project) => project.featured)!;
const sideProjects = projects.filter((project) => !project.featured);

const displayUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const urlHandle = (url: string) => `@${url.replace(/\/$/, '').split('/').pop() ?? ''}`;

const contactTiles = [
	{
		id: 'email',
		label: 'Email',
		href: `mailto:${home.contact.email}`,
		handle: home.contact.email,
		wide: true,
		icon: `<svg ${iconStroke}><rect x="3.5" y="5.5" width="17" height="13" rx="2" /><path d="m4 7.5 8 6 8-6" /></svg>`,
	},
	{
		id: 'github',
		label: 'GitHub',
		href: home.contact.githubUrl,
		handle: urlHandle(home.contact.githubUrl),
		wide: false,
		external: true,
		icon: `<svg ${iconStroke}><path d="M9 19.5c-4.3 1.4-4.3-2.1-6-2.5m12 4v-3.4c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 3.3 5.4 3.6 5.4 3.6a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 10c0 4.6 2.7 5.7 5.5 6-.6.5-.6 1.2-.5 2v3.5" /></svg>`,
	},
	{
		id: 'linkedin',
		label: 'LinkedIn',
		href: home.contact.linkedinUrl,
		handle: urlHandle(home.contact.linkedinUrl),
		wide: false,
		external: true,
		icon: `<svg ${iconStroke}><rect x="3.5" y="3.5" width="17" height="17" rx="3" /><path d="M8 10.5V17m0-6.8v.01M12.2 17v-4.2a2.4 2.4 0 0 1 4.8 0V17" /></svg>`,
	},
];

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Jan Rosell Caba',
	jobTitle: currentJobs[0]?.role ?? home.hero.role1,
	url: 'https://www.janrosell.com',
	image: 'https://www.janrosell.com/image.png',
	sameAs: [home.contact.linkedinUrl, home.contact.githubUrl],
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: "Universitat Politècnica de Catalunya (UPC) - Facultat d'Informàtica de Barcelona (FIB)",
	},
	worksFor: currentJobs.map((job) => ({ '@type': 'Organization', name: job.organization })),
	knowsAbout: [
		'Software Engineering',
		'Angular',
		'Python',
		'C++',
		'Artificial Intelligence',
		'Cybersecurity',
		'Project Management',
	],
	description: home.seo.description,
	memberOf: { '@type': 'Organization', name: home.hero.org1 },
};
---

<Layout title={home.seo.title} description={home.seo.description}>
	<div class="nav-controls" id="navControls">
		<button class="nav-button nav-toggle" id="navToggle" aria-label="Navigation menu" aria-expanded="false" aria-controls="navOverlay">
			<span class="nav-toggle-icon"></span>
		</button>
		<button class="nav-button theme-toggle" aria-label="Change theme">
			<span class="material-symbols-outlined icon-sun">light_mode</span>
			<span class="material-symbols-outlined icon-moon">dark_mode</span>
		</button>
		<a href="/terminal" class="nav-button terminal-toggle" aria-label="Open Terminal">
			<span class="material-symbols-outlined">terminal</span>
		</a>
		<a href="/blog" class="nav-button blog-link" aria-label="Go to Blog">Blog</a>
	</div>

	<nav class="nav-overlay" id="navOverlay">
		<div class="nav-overlay-content-wrapper">
			<ul>
				<li><a href="#intro" class="nav-close-link">Home</a></li>
				<li><a href="#about-me" class="nav-close-link">About Me</a></li>
				<li><a href="#technologies" class="nav-close-link">Technologies</a></li>
				<li><a href="#experience-education" class="nav-close-link">Experience</a></li>
				<li><a href="#projects" class="nav-close-link">Projects</a></li>
				<li><a href="#contact" class="nav-close-link">Contact</a></li>
			</ul>
		</div>
	</nav>

	<main>
		<div class="atmosphere" aria-hidden="true">
			<span class="atmosphere-veil"></span>
			<span class="atmosphere-aurora is-a"></span>
			<span class="atmosphere-aurora is-b"></span>
			<span class="atmosphere-aurora is-c"></span>
			<span class="atmosphere-sweep"></span>
		</div>
		<section class="content-section" id="intro">
			<h1 class="intro-title">
				<span class="line name-jan reveal-on-scroll">{home.hero.firstName}</span>
				<span class="line indent name-rosell reveal-on-scroll">{home.hero.lastName}</span>
			</h1>
			<p class="intro-subtitle reveal-on-scroll">
				<span class="highlight">{home.hero.role1}</span> at {home.hero.org1} and
				{' '}<span class="highlight">{home.hero.role2}</span> at {home.hero.org2}.
				<span class="comment-like">{home.hero.comment}</span>
			</p>
			<div class="scroll-down-indicator reveal-on-scroll" style="transition-delay: 0.6s;" id="scrollDown">
				<span class="material-symbols-outlined">south</span>
			</div>
		</section>

		<section class="content-section" id="about-me">
			<div class="content-wrapper">
				<h2 class="about-me-heading reveal-on-scroll">{home.about.heading}</h2>
				<div class="about-me-text reveal-on-scroll">
					<p set:html={home.about.paragraph1} />
					<p>
						<Fragment set:html={home.about.paragraph2} />
						<span class="comentari-estilitzat">{home.about.paragraph2Comment}</span>
					</p>
				</div>
			</div>
		</section>

		<section class="content-section" id="technologies">
			<div class="technologies-container">
				<div class="technologies-main-title-container">
					<h2 class="technologies-main-title reveal-on-scroll">{home.technologies.heading}</h2>
					<p class="technologies-subtitle reveal-on-scroll">
						{home.technologies.subtitle}
					</p>
				</div>
				<div class="skills-grid-tech">
					{
						home.technologies.categories.map((cat) => (
							<div class="skill-category-card surface-card reveal-on-scroll">
								<h3>{cat.title}</h3>
								<ul>
									{cat.skills.map((skill) => <li>{skill}</li>)}
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="content-section" id="experience-education">
			<h2 class="experience-education-title reveal-on-scroll">{home.experienceSection.heading}</h2>
			<div class="experience-education-grid">
				{
					experience.map((item, index) => (
						<div class="experience-item surface-card reveal-on-scroll" style={`--reveal-delay: ${index * 0.1}s`}>
							<h3>{item.role}</h3>
							<div class="org-date">
								<span class="organization">{item.organization}</span> | <span class="date">{item.dateRange}</span>
							</div>
							<ul>
								{item.details.map((detail) => <li>{detail}</li>)}
							</ul>
						</div>
					))
				}
			</div>
		</section>

		<section class="content-section" id="projects">
			<div class="projects-wrapper">
				<h2 class="projects-title reveal-on-scroll">
					<span>Projects_&_</span>
					<span>Ecosystem</span>
				</h2>

				<a
					class="project-card surface-card is-featured reveal-on-scroll"
					href={featuredProject.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					<div class="project-symbol" aria-hidden="true" set:html={featuredProject.icon} />
					<div class="project-copy">
						<p class="project-kicker">Hero project</p>
						<h3>{featuredProject.name}</h3>
						<p class="project-tagline">{featuredProject.tagline}</p>
						<p class="project-description">{featuredProject.description}</p>
						<span class="project-url">{displayUrl(featuredProject.url)} ↗</span>
					</div>
				</a>

				<div class="project-grid">
					{
						sideProjects.map((project, index) => (
							<a
								class="project-card surface-card reveal-on-scroll"
								href={project.url}
								target="_blank"
								rel="noopener noreferrer"
								style={`--reveal-delay: ${index * 0.1}s`}
							>
								<div class="project-symbol" aria-hidden="true" set:html={project.icon} />
								<div class="project-copy">
									<h3>{project.name}</h3>
									<p class="project-tagline">{project.tagline}</p>
									<span class="project-url">{displayUrl(project.url)} ↗</span>
								</div>
							</a>
						))
					}
				</div>
			</div>
		</section>

		<section class="content-section" id="contact">
			<h2 class="contact-heading reveal-on-scroll" set:html={home.contact.heading.replace('\n', '<br />')} />
			<p class="contact-subheading reveal-on-scroll">
				{home.contact.subheading}
			</p>

			<div class="contact-bento">
				{
					contactTiles.map((tile, index) => (
						<a
							class:list={['contact-tile', 'surface-card', 'reveal-on-scroll', { 'is-wide': tile.wide }]}
							href={tile.href}
							target={tile.external ? '_blank' : undefined}
							rel={tile.external ? 'noopener noreferrer' : undefined}
							style={`--reveal-delay: ${index * 0.08}s`}
						>
							<span class="contact-tile-icon" aria-hidden="true" set:html={tile.icon} />
							<div class="contact-tile-copy">
								<h3>{tile.label}</h3>
								<span class="contact-handle">{tile.handle}</span>
							</div>
							<span class="contact-tile-arrow" aria-hidden="true">↗</span>
						</a>
					))
				}
			</div>

			<ContactForm email={home.contact.email} />
		</section>
	</main>

	<footer class="site-footer">
		<p>&copy; {currentYear} Jan Rosell. {home.footer.tagline}</p>
	</footer>

	<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</Layout>

<script>
	const navToggle = document.getElementById('navToggle');
	const navControls = document.getElementById('navControls');
	const navOverlay = document.getElementById('navOverlay');

	function closeNav() {
		navControls?.classList.remove('menu-open');
		navOverlay?.classList.remove('open');
		navToggle?.setAttribute('aria-expanded', 'false');
	}

	navToggle?.addEventListener('click', () => {
		const isOpen = navOverlay?.classList.toggle('open');
		navControls?.classList.toggle('menu-open', isOpen);
		navToggle.setAttribute('aria-expanded', String(!!isOpen));
	});

	navOverlay?.addEventListener('click', (e) => {
		if (e.target === navOverlay) closeNav();
	});

	document.querySelectorAll('.nav-close-link').forEach((link) => {
		link.addEventListener('click', closeNav);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeNav();
	});

	document.getElementById('scrollDown')?.addEventListener('click', () => {
		document.getElementById('about-me')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
	});
</script>

<style>
	/* --- Navigation --- */
	.nav-controls {
		position: fixed;
		top: 1.5rem;
		right: 1.5rem;
		z-index: 1001;
		display: flex;
		gap: 0.6rem;
		align-items: center;
		flex-direction: row-reverse;
	}

	@media (min-width: 768px) {
		.nav-controls {
			top: 2.2rem;
			right: 2.2rem;
			gap: 0.8rem;
		}
	}

	.nav-button {
		background: none;
		border: none;
		padding: 0.4rem;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		font-family: inherit;
		border-radius: 8px;
		transition:
			color 0.3s ease,
			background-color 0.3s ease,
			filter 0.3s ease;
	}

	.nav-button .material-symbols-outlined {
		font-size: 22px;
		vertical-align: middle;
	}

	.nav-button:hover {
		color: var(--text-primary);
		background: color-mix(in srgb, var(--text-primary) 6%, transparent);
	}

	.nav-controls.menu-open .nav-toggle:hover .nav-toggle-icon,
	.nav-button:hover .nav-toggle-icon,
	.nav-button:hover .nav-toggle-icon::before,
	.nav-button:hover .nav-toggle-icon::after {
		background-color: var(--text-primary);
	}

	@media (min-width: 768px) {
		.nav-button {
			padding: 0.5rem;
		}
		.nav-button .material-symbols-outlined {
			font-size: 24px;
		}
	}

	.blog-link {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.9rem;
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
		color: var(--text-secondary);
	}

	.blog-link:hover {
		color: var(--text-primary) !important;
	}

	@media (min-width: 768px) {
		.blog-link {
			font-size: 1rem;
		}
	}

	.nav-toggle-icon {
		display: block;
		width: 24px;
		height: 2px;
		background-color: var(--text-primary);
		position: relative;
	}

	@media (min-width: 768px) {
		.nav-toggle-icon {
			width: 26px;
		}
	}

	.nav-toggle-icon::before,
	.nav-toggle-icon::after {
		content: '';
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		background-color: var(--text-primary);
		transition:
			transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
			top 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
	}

	.nav-toggle-icon::before {
		top: -6px;
	}
	.nav-toggle-icon::after {
		top: 6px;
	}

	@media (min-width: 768px) {
		.nav-toggle-icon::before {
			top: -7px;
		}
		.nav-toggle-icon::after {
			top: 7px;
		}
	}

	.nav-controls.menu-open .nav-toggle .nav-toggle-icon {
		background-color: transparent !important;
	}
	.nav-controls.menu-open .nav-toggle .nav-toggle-icon::before {
		top: 0;
		transform: rotate(45deg);
	}
	.nav-controls.menu-open .nav-toggle .nav-toggle-icon::after {
		top: 0;
		transform: rotate(-45deg);
	}

	.nav-overlay {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: var(--nav-overlay-bg);
		backdrop-filter: blur(10px);
		z-index: 1000;
		display: flex;
		flex-direction: column;
		justify-content: center;
		align-items: center;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.4s cubic-bezier(0.25, 0.1, 0.25, 1),
			visibility 0s linear 0.4s;
		pointer-events: none;
	}

	.nav-overlay.open {
		opacity: 1;
		visibility: visible;
		transition-delay: 0s;
		pointer-events: auto;
	}

	.nav-overlay-content-wrapper {
		padding: 1.5rem;
	}

	@media (min-width: 768px) {
		.nav-overlay-content-wrapper {
			padding: 2rem;
		}
	}

	.nav-overlay ul {
		list-style: none;
		text-align: center;
		padding: 0;
	}

	.nav-overlay li {
		margin-bottom: 1.8rem;
	}

	@media (min-width: 768px) {
		.nav-overlay li {
			margin-bottom: 2.2rem;
		}
	}

	.nav-overlay a {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 6vw, 2.8rem);
		font-weight: 400;
		color: var(--text-primary);
		text-decoration: none;
		transition: color 0.15s ease;
		display: inline-block;
		padding: 0.1em 0;
	}

	@media (min-width: 768px) {
		.nav-overlay a {
			font-size: clamp(2rem, 5.5vw, 3.2rem);
		}
	}

	.nav-overlay a:hover {
		color: var(--text-primary);
	}

	.nav-overlay a::before {
		content: '> ';
		font-family: var(--font-mono);
		color: var(--text-highlight-blue);
		opacity: 0;
		transition:
			opacity 0.3s ease,
			transform 0.3s ease;
		display: inline-block;
		transform: translateX(-10px);
	}

	.nav-overlay a:hover::before {
		opacity: 1;
		transform: translateX(0);
	}

	/* --- Main sections --- */
	.content-section {
		--section-bg: var(--bg-main);
		min-height: 100vh;
		padding: 15vh 5vw;
		display: flex;
		flex-direction: column;
		justify-content: center;
		position: relative;
		z-index: 1;
		overflow: visible;
		background: transparent;
	}

	.content-section > * {
		position: relative;
		z-index: 1;
	}

	@media (min-width: 768px) {
		.content-section {
			padding: 12vh 5vw;
		}
	}

	/* --- Hero / intro --- */
	#intro {
		text-align: left;
	}

	/* --- Atmosphere --- */
	.atmosphere {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}

	.atmosphere-veil {
		position: absolute;
		inset: -45%;
		background: conic-gradient(
			from 180deg at 48% 40%,
			transparent 0deg,
			color-mix(in srgb, var(--text-highlight-blue) 8%, transparent) 52deg,
			transparent 118deg,
			color-mix(in srgb, var(--text-primary) 4%, transparent) 198deg,
			transparent 270deg,
			color-mix(in srgb, var(--text-highlight-blue) 6%, transparent) 328deg,
			transparent 360deg
		);
		opacity: 0.5;
		animation: veil-turn 96s linear infinite;
	}

	.atmosphere-aurora {
		position: absolute;
		border-radius: 50%;
		filter: blur(100px);
		background: color-mix(in srgb, var(--text-highlight-blue) 24%, transparent);
		opacity: 0.48;
		will-change: transform;
	}

	.atmosphere-aurora.is-a {
		width: min(118vw, 1480px);
		height: min(36vh, 320px);
		top: -10%;
		left: -22%;
		animation: aurora-a 46s ease-in-out infinite;
	}

	.atmosphere-aurora.is-b {
		width: min(72vw, 920px);
		height: min(58vh, 540px);
		top: 16%;
		right: -24%;
		opacity: 0.3;
		animation: aurora-b 58s ease-in-out infinite;
	}

	.atmosphere-aurora.is-c {
		width: min(96vw, 1180px);
		height: min(28vh, 260px);
		bottom: -12%;
		left: 8%;
		opacity: 0.26;
		animation: aurora-c 52s ease-in-out infinite;
	}

	.atmosphere-sweep {
		position: absolute;
		left: -18%;
		width: 136%;
		height: 24vh;
		background: linear-gradient(
			180deg,
			transparent,
			color-mix(in srgb, var(--text-highlight-blue) 16%, transparent),
			transparent
		);
		filter: blur(32px);
		opacity: 0;
		animation: sweep-pass 68s ease-in-out infinite;
	}

	html:not(.dark-theme) .atmosphere-veil {
		opacity: 0.22;
	}

	html:not(.dark-theme) .atmosphere-aurora {
		opacity: 0.18;
	}

	html:not(.dark-theme) .atmosphere-aurora.is-b,
	html:not(.dark-theme) .atmosphere-aurora.is-c {
		opacity: 0.12;
	}

	@keyframes veil-turn {
		to {
			transform: rotate(1turn);
		}
	}

	@keyframes aurora-a {
		0%,
		100% {
			transform: rotate(-18deg) translate(0, 0) scale(1);
		}
		50% {
			transform: rotate(-11deg) translate(5%, 7%) scale(1.06);
		}
	}

	@keyframes aurora-b {
		0%,
		100% {
			transform: rotate(22deg) translate(0, 0) scale(1);
		}
		40% {
			transform: rotate(16deg) translate(-6%, 5%) scale(1.05);
		}
		70% {
			transform: rotate(26deg) translate(4%, -4%) scale(0.97);
		}
	}

	@keyframes aurora-c {
		0%,
		100% {
			transform: rotate(-8deg) translate(0, 0) scale(1);
		}
		50% {
			transform: rotate(-3deg) translate(-7%, -6%) scale(1.08);
		}
