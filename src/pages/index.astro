	/* --- Reveal-on-scroll animation --- */
	.reveal-on-scroll {
		opacity: 0;
		transform: translateY(20px);
		transition:
			opacity 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) var(--reveal-delay, 0s),
			transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) var(--reveal-delay, 0s);
	}

	a.surface-card.reveal-on-scroll {
		transition:
			opacity 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) var(--reveal-delay, 0s),
			transform 0.8s cubic-bezier(0.165, 0.84, 0.44, 1) var(--reveal-delay, 0s),
			border-color 0.1s ease,
			background-color 0.1s ease;
	}

	.reveal-on-scroll.is-visible {
		opacity: 1;
		transform: translateY(0);
	}

	@media (prefers-reduced-motion: reduce) {
		.nav-overlay a:hover::before {
			transform: none;
		}

		.reveal-on-scroll {
			opacity: 1;
			transform: none;
			transition: none;
		}

		.atmosphere-veil,
		.atmosphere-aurora,
		.atmosphere-sweep {
			animation: none;
		}

		.atmosphere-sweep {
