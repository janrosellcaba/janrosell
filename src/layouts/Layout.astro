---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Jan Rosell - AI Systems & Solutions Engineer | Co-founder & CTO',
	description = 'Personal portfolio of Jan Rosell, AI Systems & Solutions Engineer at Dot Consulting, Co-founder & CTO at Express My Health. Discover my projects, experience, and skills in TypeScript, Node.js, and Data/AI.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark-theme">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<link rel="icon" type="image/png" href="/image.png" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/image.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
		/>

		<!-- Google tag (gtag.js) -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-CRGV1425LM" is:inline></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-CRGV1425LM');
		</script>

		<script is:inline>
			(function () {
				var stored = localStorage.getItem('theme');
				if (stored === 'light') document.documentElement.classList.remove('dark-theme');
			})();
		</script>
	</head>
	<body>
		<slot />

		<Analytics />

		<script is:inline>
			(function () {
				var key = 'jr-visit';
				var sid = sessionStorage.getItem(key);
				if (!sid) {
					sid = Math.random().toString(36).slice(2, 10) + Math.random().toString(36).slice(2, 6);
					sessionStorage.setItem(key, sid);
				}
				var started = Date.now();
				var maxScroll = 0;
				var lastDepth = -1;
				var scrollTimer = 0;
				var queue = [];
				var left = false;
				var page = location.pathname;

				function depth() {
					var el = document.documentElement;
					var full = el.scrollHeight - el.clientHeight;
					if (full <= 0) return 100;
					return Math.max(0, Math.min(100, Math.round((el.scrollTop / full) * 100)));
				}

				function fieldLabel(el) {
					var id = el.id || '';
					var lab = id ? document.querySelector('label[for="' + id.replace(/"/g, '') + '"]') : null;
					var text = lab ? lab.textContent : el.getAttribute('aria-label') || el.getAttribute('name');
					return (text || 'field').replace(/\s+/g, ' ').trim().slice(0, 80);
				}

				function clickLabel(el) {
					if (!el || !el.tagName) return '';
					var tag = el.tagName;
					if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT' || el.isContentEditable) {
						return fieldLabel(el);
					}
					return (el.innerText || el.getAttribute('aria-label') || tag)
						.replace(/\s+/g, ' ')
						.trim()
						.slice(0, 80);
				}

				function send(events, beacon) {
					if (!events.length) return;
					var body = JSON.stringify({ sid: sid, path: page, events: events });
					if (beacon && navigator.sendBeacon) {
						navigator.sendBeacon('/api/visit', new Blob([body], { type: 'application/json' }));
						return;
					}
					fetch('/api/visit', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: body,
						keepalive: true,
					}).catch(function () {});
				}

				function push(event) {
					event.t = Date.now();
					queue.push(event);
				}

				function flush(beacon) {
					if (!queue.length) return;
					send(queue.splice(0, 20), beacon);
				}

				push({
					type: 'enter',
					referrer: document.referrer || '',
					w: window.innerWidth,
					h: window.innerHeight,
				});

				addEventListener('scroll', function () {
					var d = depth();
					if (d > maxScroll) maxScroll = d;
					clearTimeout(scrollTimer);
					scrollTimer = setTimeout(function () {
						if (d === lastDepth) return;
						lastDepth = d;
						push({ type: 'scroll', depth: d });
						flush(false);
					}, 800);
				}, { passive: true });

				addEventListener('click', function (event) {
					var el = event.target;
					if (el && el.nodeType !== 1) el = el.parentElement;
					if (el && el.closest) {
						el = el.closest('a, button, input, textarea, select, label, [role="button"]') || el;
					}
					if (!el || !el.tagName) return;
					var isField = el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' || el.isContentEditable;
					var item = { type: 'click', target: clickLabel(el) };
					if (isField) item.kind = 'field';
					if (el.tagName === 'A') item.href = el.getAttribute('href') || '';
					push(item);
					flush(false);
				}, true);

				function leave() {
					if (left) return;
					left = true;
					push({ type: 'leave', depth: maxScroll, ms: Date.now() - started });
					flush(true);
				}

				addEventListener('pagehide', leave);
				document.addEventListener('visibilitychange', function () {
					if (document.visibilityState === 'hidden') leave();
					else left = false;
				});
				setInterval(function () { flush(false); }, 5000);
			})();
		</script>

		<script>
			function applyTheme(theme: 'light' | 'dark') {
				document.documentElement.classList.toggle('dark-theme', theme === 'dark');
				localStorage.setItem('theme', theme);
			}

			document.querySelectorAll('.theme-toggle').forEach((btn) => {
				btn.addEventListener('click', () => {
					const isDark = document.documentElement.classList.contains('dark-theme');
					applyTheme(isDark ? 'light' : 'dark');
				});
			});

			const revealTargets = document.querySelectorAll('.reveal-on-scroll');
			if (revealTargets.length) {
				const observer = new IntersectionObserver(
					(entries, obs) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								obs.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.1 },
				);
				revealTargets.forEach((el) => observer.observe(el));
			}
		</script>
	</body>
</html>
